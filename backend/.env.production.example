# The variables to set on the host (Vercel: Project > Settings > Environment Variables).
# Copy this file to backend/.env.production for your own reference; that name is git-ignored.
APP_ENV=production

# Neon: use the DIRECT connection string (Connection pooling OFF).
DATABASE_URL=postgresql://USER:PASSWORD@ep-YOUR-PROJECT.neon.tech/neondb?sslmode=require

# Required in production: 32+ random characters, the app refuses to start otherwise.
JWT_SECRET=paste-output-of: python -c "import secrets; print(secrets.token_urlsafe(48))"

COOKIE_SECURE=true
APP_TIMEZONE=Asia/Kolkata

# Serverless runs many small instances, so keep each one's pool tiny.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
