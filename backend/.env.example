# Local development: copy to backend/.env  (the app reads .env from the directory it starts in).
# Every value has a working development default except JWT_SECRET in production.
# Production values live in backend/.env.production.example -> set them in Vercel, never commit them.
APP_ENV=development

# Any SQLAlchemy URL. Leave as-is for a local SQLite file, or use Neon / any Postgres:
#   DATABASE_URL=postgresql://user:password@ep-your-project.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./gymflow.db

# 32+ random characters. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# The gym's local day drives attendance and expiry.
APP_TIMEZONE=Asia/Kolkata

# true when served over HTTPS (keeps the refresh cookie off plain HTTP)
COOKIE_SECURE=false
