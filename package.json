{
  "name": "ps76-gymflow",
  "private": true,
  "description": "PS76 hackathon app — gym membership & class booking on Firebase",
  "type": "module",
  "scripts": {
    "serve": "firebase emulators:start",
    "test": "firebase emulators:exec --only firestore --project demo-ps76 \"node --test tests/*.test.js\"",
    "deploy": "node tools/deploy.cjs",
    "deploy:cli": "firebase deploy --only hosting,firestore:rules,firestore:indexes"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.0.0",
    "google-auth-library": "^9.15.1"
  }
}
